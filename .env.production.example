# COLLABIZ production / pilot environment template.
# Store real values in a secrets manager (AWS Secrets Manager, GCP Secret Manager, Vault) — never in git.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production
API_PORT=4000
DATABASE_URL=postgres://collabiz_app:<password>@<db-host>:5432/collabiz?sslmode=require
REDIS_URL=rediss://<redis-host>:6379

# Required: the API refuses to start with development defaults.
JWT_ACCESS_SECRET=<64 hex chars>
JWT_REFRESH_SECRET=<64 hex chars, different>
DOWNLOAD_URL_SECRET=<64 hex chars, different>
FIELD_ENCRYPTION_KEY=<64 hex chars — losing it makes encrypted bank/PAN data unreadable; back it up separately>

CORS_ORIGINS=https://<web-domain>,https://<admin-domain>
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
AUTH_RATE_LIMIT=20
# Global per-client-IP limit (requests/minute). Requires the load balancer to set X-Forwarded-For.
API_RATE_LIMIT=300
DUAL_APPROVAL_THRESHOLD=50000000
EXPOSE_API_DOCS=false

# --- Integrations (blockers B-03, B-04, B-05, B-08 until configured) ---
STORAGE_DRIVER=local            # must become s3 before pilot (B-03); local requires a persistent, backed-up volume
STORAGE_LOCAL_DIR=/data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAIL_DRIVER=outbox              # set to smtp before pilot: OTP codes are otherwise not delivered
SMTP_URL=                       # smtps://user:password@smtp-host:465 (any provider)
MAIL_FROM=COLLABIZ <no-reply@<your-domain>>
WEB_BASE_URL=https://<web-domain>
IDENTITY_PROVIDER=local
AI_PROVIDER=rules
ESIGN_PROVIDER=local
MEETING_PROVIDER=local

# Never enable in production
DEV_EXPOSE_OTP=false
FEATURE_INVESTOR_DATA_ROOM=false
FEATURE_FINANCE_INTRODUCTIONS=false

# --- Web / Admin containers ---
API_INTERNAL_URL=http://api:4000
