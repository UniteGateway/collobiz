{
  "name": "@collabiz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register src/db/migrate.ts",
    "db:seed": "node -r @swc-node/register src/db/seed.ts",
    "openapi": "node -r @swc-node/register src/openapi-export.ts"
  },
  "dependencies": {
    "@collabiz/types": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "multer": "^2.0.2",
    "nodemailer": "6.9.16",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@collabiz/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3"
  }
}
