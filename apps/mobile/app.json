{
  "expo": {
    "name": "COLLABIZ",
    "slug": "collabiz",
    "scheme": "collabiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "image": "./assets/logo.png", "resizeMode": "contain", "backgroundColor": "#FFFFFF" },
    "ios": { "bundleIdentifier": "group.unite.collabiz", "supportsTablet": true },
    "android": { "package": "group.unite.collabiz", "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#FFFFFF" } },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
