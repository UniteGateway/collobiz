{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": false, "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "https://api.staging.example.invalid" } },
    "pilot": {
      "distribution": "internal",
      "channel": "pilot",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.pilot.example.invalid" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.collabiz.example.invalid" }
    }
  },
  "submit": { "production": {} }
}
