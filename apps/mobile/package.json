{
  "name": "@collabiz/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "jest"
  },
  "dependencies": {
    "@collabiz/types": "workspace:*",
    "@collabiz/ui": "workspace:*",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "expo-system-ui": "~58.0.7"
  },
  "devDependencies": {
    "@collabiz/config": "workspace:*",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.14",
    "typescript": "~5.9.3",
    "react-test-renderer": "19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@collabiz/.*)"
    ]
  }
}
