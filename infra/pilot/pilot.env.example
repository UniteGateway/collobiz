# COLLABIZ pilot settings. Copy to pilot.env on the server (chmod 600) — NEVER commit the filled-in copy.
# Generate each secret with:  openssl rand -hex 32
WEB_DOMAIN=collabiz.<your-domain>
ADMIN_DOMAIN=admin.collabiz.<your-domain>
ACME_EMAIL=<it-contact@your-domain>
# Space-separated office/VPN IP ranges allowed to open the admin console, e.g. "203.0.113.10/32 198.51.100.0/24"
ADMIN_ALLOW_IPS=0.0.0.0/0 ::/0

POSTGRES_PASSWORD=<openssl rand -hex 24>
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32, different>
DOWNLOAD_URL_SECRET=<openssl rand -hex 32, different>
# Losing this key makes stored bank/PAN details unreadable. Keep a copy in a password manager AWAY from the backups.
FIELD_ENCRYPTION_KEY=<openssl rand -hex 32>

# E-mail (required — sign-in codes and invitations). Any SMTP provider works.
MAIL_DRIVER=smtp
SMTP_URL=smtps://<user>:<password>@<smtp-host>:465
MAIL_FROM=COLLABIZ <no-reply@<your-domain>>

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=300
DUAL_APPROVAL_THRESHOLD=50000000
EXPOSE_API_DOCS=false
DEMO_MODE=false
DEV_EXPOSE_OTP=false
IDENTITY_PROVIDER=local
AI_PROVIDER=rules
ESIGN_PROVIDER=local
MEETING_PROVIDER=local
FEATURE_INVESTOR_DATA_ROOM=false
FEATURE_FINANCE_INTRODUCTIONS=false
