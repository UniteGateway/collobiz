{
  "name": "collabiz",
  "private": true,
  "description": "COLLABIZ \u2014 Connect. Collaborate. Grow. Powered by Unite Group.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present --filter ./packages/** run build && pnpm -r --filter ./apps/** --filter !@collabiz/mobile run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @collabiz/api dev",
    "dev:web": "pnpm --filter @collabiz/web dev",
    "dev:admin": "pnpm --filter @collabiz/admin dev",
    "dev:mobile": "pnpm --filter @collabiz/mobile start",
    "db:migrate": "pnpm --filter @collabiz/api db:migrate",
    "db:seed": "pnpm --filter @collabiz/api db:seed",
    "registry": "node scripts/generate-registry.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "a11y": "node scripts/a11y-scan.mjs"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "~19.2.0",
      "multer": "^2.5.0"
    }
  },
  "devDependencies": {
    "axe-core": "4.10.3"
  }
}
